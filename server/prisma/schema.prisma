generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A login account. role is one of: ADMIN | TEACHER | GUARDIAN
model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         String
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  teacher             Teacher?
  guardian            Guardian?
  auditLogs           AuditLog[]
  recordedAttendances Attendance[]

  @@map("users")
}

model Guardian {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  name      String
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id])
  guardianStudents GuardianStudent[]

  @@map("guardians")
}

model Teacher {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  name      String
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id])
  classSubjects ClassSubject[]

  @@map("teachers")
}

// Academic Class / Grade level (e.g. "Grade 9", "Grade 10")
model Class {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  sections Section[]

  @@map("classes")
}

// Section within a class (e.g. "A", "B").
// Unique constraint on (classId, name) ensures Grade 10 cannot have two 'A' sections.
model Section {
  id        Int      @id @default(autoincrement())
  name      String
  classId   Int      @map("class_id")
  createdAt DateTime @default(now()) @map("created_at")

  class         Class          @relation(fields: [classId], references: [id])
  students      Student[]
  classSubjects ClassSubject[]
  exams         Exam[]

  @@unique([classId, name])
  @@map("sections")
}

model Subject {
  id        Int      @id @default(autoincrement())
  name      String
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  classSubjects ClassSubject[]
  exams         Exam[]

  @@map("subjects")
}

// Links one teacher to one subject within one class section.
model ClassSubject {
  id        Int @id @default(autoincrement())
  sectionId Int @map("section_id")
  subjectId Int @map("subject_id")
  teacherId Int @map("teacher_id")

  section Section @relation(fields: [sectionId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@unique([sectionId, subjectId])
  @@index([teacherId])
  @@map("class_subjects")
}

model Student {
  id         Int      @id @default(autoincrement())
  name       String
  dob        String? // YYYY-MM-DD
  gender     String? // MALE | FEMALE | OTHER
  rollNumber String?  @map("roll_number")
  sectionId  Int?     @map("section_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  section          Section?          @relation(fields: [sectionId], references: [id])
  guardianStudents GuardianStudent[]
  attendances      Attendance[]
  examResults      ExamResult[]
  feeInvoices      FeeInvoice[]
  feeLedgerEntries FeeLedgerEntry[]

  @@index([sectionId])
  @@map("students")
}

// Explicit join table linking guardians to students with relationship type.
model GuardianStudent {
  id           Int      @id @default(autoincrement())
  guardianId   Int      @map("guardian_id")
  studentId    Int      @map("student_id")
  relationship String   @default("Parent") // Father, Mother, Guardian, etc.
  createdAt    DateTime @default(now()) @map("created_at")

  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([guardianId, studentId])
  @@index([studentId])
  @@index([guardianId])
  @@map("guardian_students")
}

// Unique constraint on (studentId, date, session) prevents duplicates at the DB level.
// session is MORNING | AFTERNOON. status is PRESENT | ABSENT | LATE.
model Attendance {
  id           Int      @id @default(autoincrement())
  studentId    Int      @map("student_id")
  date         String // YYYY-MM-DD
  session      String // MORNING | AFTERNOON
  status       String // PRESENT | ABSENT | LATE
  recordedById Int      @map("recorded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  student    Student @relation(fields: [studentId], references: [id])
  recordedBy User    @relation(fields: [recordedById], references: [id])

  @@unique([studentId, date, session])
  @@index([date])
  @@index([studentId])
  @@map("attendance")
}

// Configurable grading bands. minPercent is inclusive, maxPercent is inclusive.
model GradeRule {
  id         Int    @id @default(autoincrement())
  minPercent Float  @map("min_percent")
  maxPercent Float  @map("max_percent")
  grade      String
  gradePoint Float  @map("grade_point")

  @@map("grade_rules")
}

model Exam {
  id        Int      @id @default(autoincrement())
  name      String
  sectionId Int      @map("section_id")
  subjectId Int      @map("subject_id")
  maxMarks  Int      @map("max_marks")
  examDate  String   @map("exam_date") // YYYY-MM-DD
  createdAt DateTime @default(now()) @map("created_at")

  section Section      @relation(fields: [sectionId], references: [id])
  subject Subject      @relation(fields: [subjectId], references: [id])
  results ExamResult[]

  @@index([sectionId])
  @@map("exams")
}

// Unique per exam+student. Grades are computed dynamically from GradeRule on read.
model ExamResult {
  id            Int      @id @default(autoincrement())
  examId        Int      @map("exam_id")
  studentId     Int      @map("student_id")
  marksObtained Int      @map("marks_obtained")
  calculatedAt  DateTime @default(now()) @map("calculated_at")

  exam    Exam    @relation(fields: [examId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@unique([examId, studentId])
  @@map("exam_results")
}

// Amounts are stored in integer paise (1 INR = 100 paise) to avoid floating-point rounding.
model FeeType {
  id            Int    @id @default(autoincrement())
  name          String @unique
  defaultAmount Int    @map("default_amount")

  invoices FeeInvoice[]

  @@map("fee_types")
}

// status transitions: UNPAID -> PARTIAL -> PAID, or UNPAID -> VOID.
model FeeInvoice {
  id        Int      @id @default(autoincrement())
  studentId Int      @map("student_id")
  feeTypeId Int      @map("fee_type_id")
  amountDue Int      @map("amount_due")
  dueDate   String   @map("due_date") // YYYY-MM-DD
  status    String   @default("UNPAID") // UNPAID | PARTIAL | PAID | VOID
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  student       Student          @relation(fields: [studentId], references: [id])
  feeType       FeeType          @relation(fields: [feeTypeId], references: [id])
  payments      FeePayment[]
  ledgerEntries FeeLedgerEntry[]

  @@index([studentId])
  @@map("fee_invoices")
}

// idempotencyKey is unique: a repeated key returns the original payment instead of creating a second one.
model FeePayment {
  id             Int      @id @default(autoincrement())
  invoiceId      Int      @map("invoice_id")
  amountPaid     Int      @map("amount_paid")
  idempotencyKey String   @unique @map("idempotency_key")
  paidAt         DateTime @default(now()) @map("paid_at")

  invoice       FeeInvoice       @relation(fields: [invoiceId], references: [id])
  ledgerEntries FeeLedgerEntry[]

  @@index([invoiceId])
  @@map("fee_payments")
}

// Student Fee Ledger: records financial debits (invoice raised) and credits (payment made).
// Used to compute running balances and reconcile fee totals with the ledger.
model FeeLedgerEntry {
  id          Int      @id @default(autoincrement())
  studentId   Int      @map("student_id")
  invoiceId   Int?     @map("invoice_id")
  paymentId   Int?     @map("payment_id")
  entryType   String   @map("entry_type") // DEBIT | CREDIT
  amount      Int // amount in paise
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  student Student     @relation(fields: [studentId], references: [id])
  invoice FeeInvoice? @relation(fields: [invoiceId], references: [id])
  payment FeePayment? @relation(fields: [paymentId], references: [id])

  @@index([studentId])
  @@index([createdAt])
  @@map("fee_ledger_entries")
}

// Append-only audit trail for material business actions. meta is a JSON string.
model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   Int      @map("entity_id")
  meta       String?
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
